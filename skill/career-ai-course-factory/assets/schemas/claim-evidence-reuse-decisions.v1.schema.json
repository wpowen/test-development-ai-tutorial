{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-evidence-reuse-decisions.v1.schema.json",
  "title": "ClaimEvidenceReuseDecisionsV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_set_id", "map_digest", "decisions"],
  "properties": {
    "schema_version": {"const": "claim-evidence-reuse-decisions.v1"},
    "decision_set_id": {"type": "string", "minLength": 1},
    "map_digest": {"$ref": "#/$defs/digest"},
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["equal", "not-equal", "unknown"]},
    "equivalence": {"type": "object", "additionalProperties": false, "required": ["identity", "scope", "version", "environment", "region", "risk", "population", "predicate", "verdict"], "properties": {"identity": {"$ref": "#/$defs/status"}, "scope": {"$ref": "#/$defs/status"}, "version": {"$ref": "#/$defs/status"}, "environment": {"$ref": "#/$defs/status"}, "region": {"$ref": "#/$defs/status"}, "risk": {"$ref": "#/$defs/status"}, "population": {"$ref": "#/$defs/status"}, "predicate": {"$ref": "#/$defs/status"}, "verdict": {"enum": ["exact", "delta-required", "incompatible", "unknown"]}}},
    "digests": {"type": "object", "additionalProperties": false, "required": ["scope_digest", "version_digest", "environment_digest", "region_digest", "risk_digest"], "properties": {"scope_digest": {"$ref": "#/$defs/digest"}, "version_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "region_digest": {"$ref": "#/$defs/digest"}, "risk_digest": {"$ref": "#/$defs/digest"}}},
    "targetEvidence": {"type": "object", "additionalProperties": false, "required": ["required", "status", "evidence_refs"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUN", "BLOCKED"]}, "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/targetLocator"}}}, "allOf": [{"if": {"properties": {"status": {"enum": ["UNKNOWN", "NOT_RUN", "BLOCKED"]}}}, "then": {"properties": {"evidence_refs": {"maxItems": 0}}}}, {"if": {"properties": {"status": {"enum": ["PASS", "FAIL"]}}}, "then": {"properties": {"evidence_refs": {"minItems": 1}}}}]},
    "targetLocator": {"type": "object", "additionalProperties": false, "required": ["locator_id", "kind", "uri_or_path", "digest"], "properties": {"locator_id": {"type": "string", "minLength": 1}, "kind": {"const": "target"}, "uri_or_path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "invalidation": {"type": "object", "additionalProperties": false, "required": ["status", "triggers", "invalidates_node_ids"], "properties": {"status": {"enum": ["current", "superseded", "invalid"]}, "triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "invalidates_node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"status": {"enum": ["superseded", "invalid"]}}}, "then": {"properties": {"invalidates_node_ids": {"minItems": 1}}}}]},
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "claim_id", "bundle_id", "bundle_revision", "bundle_digest", "member_claim_id", "predicate_id", "predicate_scope_digest", "decision", "equivalence", "digests", "target_evidence", "local_transfer_locator", "cannot_prove", "invalidation", "rationale"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1}, "claim_id": {"type": "string", "minLength": 1}, "bundle_id": {"type": "string", "minLength": 1}, "bundle_revision": {"type": "integer", "minimum": 1}, "bundle_digest": {"$ref": "#/$defs/digest"}, "member_claim_id": {"type": "string", "minLength": 1}, "predicate_id": {"type": "string", "minLength": 1}, "predicate_scope_digest": {"$ref": "#/$defs/digest"},
        "decision": {"enum": ["DIRECT-REUSE", "SOURCE-REUSE-DELTA", "NO-REUSE"]}, "equivalence": {"$ref": "#/$defs/equivalence"}, "digests": {"$ref": "#/$defs/digests"}, "target_evidence": {"$ref": "#/$defs/targetEvidence"}, "local_transfer_locator": {"type": "string", "minLength": 1}, "cannot_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "invalidation": {"$ref": "#/$defs/invalidation"}, "rationale": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"decision": {"const": "DIRECT-REUSE"}}}, "then": {"properties": {"equivalence": {"properties": {"verdict": {"const": "exact"}}}}}},
        {"if": {"properties": {"decision": {"const": "SOURCE-REUSE-DELTA"}}}, "then": {"properties": {"equivalence": {"properties": {"verdict": {"const": "delta-required"}}}}}},
        {"if": {"properties": {"decision": {"const": "NO-REUSE"}}}, "then": {"properties": {"equivalence": {"properties": {"verdict": {"enum": ["incompatible", "unknown"]}}}}}},
        {"if": {"properties": {"equivalence": {"properties": {"verdict": {"const": "unknown"}}}}}, "then": {"properties": {"decision": {"const": "NO-REUSE"}}}},
        {"if": {"properties": {"target_evidence": {"properties": {"required": {"const": true}}}}}, "then": {"properties": {"decision": {"const": "NO-REUSE"}}}}
      ]
    }
  }
}

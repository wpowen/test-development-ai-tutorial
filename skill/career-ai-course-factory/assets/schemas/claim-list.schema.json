{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-list.schema.json",
  "type": "object",
  "required": ["schema_version", "topic_id", "reviewed_by", "unmapped_propositions", "claims"],
  "properties": {
    "schema_version": {"const": "claim-list.v1"},
    "topic_id": {"type": "string", "minLength": 1},
    "reviewed_by": {"type": "string", "minLength": 1},
    "unmapped_propositions": {"const": 0},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "claim_type", "risk", "scope", "source_locations", "required_dimensions", "proposed_disposition"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string", "minLength": 1},
          "risk": {"enum": ["low", "medium", "high", "critical"]},
          "scope": {"type": "string", "minLength": 1},
          "source_locations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "proposed_disposition": {"enum": ["SUPPORTED", "SCOPED", "UNKNOWN-EXPLICIT", "REJECTED"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

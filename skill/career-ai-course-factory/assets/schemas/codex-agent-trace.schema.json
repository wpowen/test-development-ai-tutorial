{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-agent-trace.schema.json",
  "type": "object",
  "required": ["schema_version", "surface", "run_id", "topic_id", "claim_ids", "phase", "round", "status", "started_at", "completed_at", "orchestrator", "agents", "events", "citations", "limitations", "runtime_attestation"],
  "properties": {
    "schema_version": {"const": "codex-runtime-trace.v1"},
    "surface": {"const": "codex-research"},
    "run_id": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "claim_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
    "phase": {"enum": ["initial-research", "counterevidence", "gap-fill", "verification"]},
    "round": {"type": "integer", "minimum": 1},
    "status": {"const": "completed"},
    "started_at": {"type": "string", "minLength": 1},
    "completed_at": {"type": "string", "minLength": 1},
    "orchestrator": {
      "type": "object",
      "required": ["runtime_observed_agent_id", "runtime", "session_id", "trace_id"]
    },
    "agents": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["runtime_observed_agent_id", "role", "provider", "runtime", "session_id", "parent_invocation_id", "independence_group", "input_context_sha256", "prompt_sha256", "input_artifacts", "output_path", "output_sha256"]
      }
    },
    "events": {"type": "array", "items": {"type": "object"}},
    "citations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
    ,"runtime_attestation": {
      "type": "object",
      "required": ["schema_version", "algorithm", "key_id", "payload_sha256", "signature_base64"],
      "properties": {
        "schema_version": {"const": "codex-runtime-attestation.v1"},
        "algorithm": {"const": "rsa-sha256"},
        "key_id": {"type": "string", "minLength": 1},
        "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signature_base64": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": true
}

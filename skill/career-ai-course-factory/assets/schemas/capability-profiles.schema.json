{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfessionalCapabilityProfiles",
  "type": "object",
  "required": ["schema_version", "pages"],
  "properties": {
    "schema_version": {"type": "string"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_id", "capabilities", "rationale", "risk", "reviewer", "reviewed_at", "evidence_refs"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["profession-baseline", "artifact-transformation", "ai-system-evaluation", "supervised-agent-workflow", "ai-quality-system", "career-evolution-system", "agent-architecture-testing"]}
          },
          "rationale": {"type": "string", "minLength": 1},
          "risk": {"type": "string", "minLength": 1},
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

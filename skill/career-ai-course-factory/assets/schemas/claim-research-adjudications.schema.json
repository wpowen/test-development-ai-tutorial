{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-research-adjudications.schema.json",
  "type": "object",
  "required": ["schema_version", "topic_id", "auditor_id", "claims"],
  "properties": {
    "schema_version": {"const": "claim-research-adjudications.v1"},
    "topic_id": {"type": "string", "minLength": 1},
    "auditor_id": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "claim_id", "run_ids", "coverage_dimensions", "contradiction_status",
          "contradictions", "two_consecutive_rounds_without_material_change",
          "conclusive_primary_authority_exception", "round_assessments",
          "final_disposition", "verdict", "rationale"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "run_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "coverage_dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["dimension", "status", "evidence_or_reason"],
              "properties": {
                "dimension": {"type": "string", "minLength": 1},
                "status": {"enum": ["covered", "not-applicable"]},
                "evidence_or_reason": {"type": "string", "minLength": 1}
              }
            }
          },
          "contradiction_status": {"enum": ["resolved", "preserved-unresolved", "none-found"]},
          "contradictions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["issue", "run_ids", "disposition", "rationale"],
              "properties": {
                "issue": {"type": "string", "minLength": 1},
                "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "disposition": {"type": "string", "minLength": 1},
                "rationale": {"type": "string", "minLength": 1}
              }
            }
          },
          "two_consecutive_rounds_without_material_change": {"type": "boolean"},
          "conclusive_primary_authority_exception": {"type": "boolean"},
          "primary_authority_exception_rationale": {"type": "string"},
          "round_assessments": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["run_id", "material_change", "assessment"],
              "properties": {
                "run_id": {"type": "string", "minLength": 1},
                "material_change": {"type": "boolean"},
                "assessment": {"type": "string", "minLength": 1}
              }
            }
          },
          "final_disposition": {"enum": ["SUPPORTED", "SCOPED", "UNKNOWN-EXPLICIT", "REJECTED"]},
          "verdict": {"const": "SATURATED"},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

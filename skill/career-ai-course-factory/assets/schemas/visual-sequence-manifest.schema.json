{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisualSequenceManifest",
  "type": "object",
  "required": ["schema_version", "ordered_page_ids", "pages", "verdict"],
  "properties": {
    "schema_version": {"type": "string"},
    "ordered_page_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "verdict": {"const": "PASS"},
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_id", "display_number", "prerequisite_ids", "knowledge_relationship", "required_visual_kinds", "visuals"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "display_number": {"type": "integer", "minimum": 1},
          "prerequisite_ids": {"type": "array", "items": {"type": "string"}},
          "knowledge_relationship": {"type": "string", "minLength": 1},
          "required_visual_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "visuals": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["visual_id", "kind", "purpose", "source_path", "alt_text", "caption", "nodes", "edges", "source_refs"],
              "properties": {
                "visual_id": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1},
                "purpose": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "alt_text": {"type": "string", "minLength": 1},
                "caption": {"type": "string", "minLength": 1},
                "nodes": {"type": "array", "minItems": 5, "items": {"type": "string"}},
                "edges": {"type": "array", "minItems": 4, "items": {"type": "string"}},
                "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}

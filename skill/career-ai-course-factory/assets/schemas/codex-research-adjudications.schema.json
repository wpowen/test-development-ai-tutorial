{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex-research-adjudications.schema.json",
  "type": "object",
  "required": ["schema_version", "topic_id", "auditor_id", "claims"],
  "properties": {
    "schema_version": {"const": "codex-research-adjudications.v1"},
    "topic_id": {"type": "string", "minLength": 1},
    "auditor_id": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "run_ids", "coverage_dimensions", "contradiction_status", "contradictions", "two_consecutive_rounds_without_material_change", "conclusive_primary_authority_exception", "round_assessments", "final_disposition", "verdict", "rationale"]
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-route-dry-run-manifest.v1.schema.json",
  "title": "ResearchRouteDryRunManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dry_run_id", "generated_at", "input_inventory_digests", "map_digest", "status", "counts", "routes", "reuse", "invalidation", "unclassified_count"],
  "properties": {
    "schema_version": {"const": "research-route-dry-run-manifest.v1"}, "dry_run_id": {"type": "string", "minLength": 1}, "generated_at": {"type": "string", "minLength": 1}, "input_inventory_digests": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "map_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "classification_overlay_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "status": {"enum": ["READY", "BLOCKED"]},
    "page_coverage": {"$ref": "#/$defs/pageCoverage"},
    "counts": {"type": "object", "additionalProperties": false, "required": ["pages_expected", "pages_with_claim_inventory", "missing_page_count", "unexpected_page_count", "pages_total", "claims_total", "eligible_external_units_before", "canonical_external_units_after", "local_units", "target_units", "teaching_units", "blocked_units"], "properties": {"pages_expected": {"type": "integer", "minimum": 0}, "pages_with_claim_inventory": {"type": "integer", "minimum": 0}, "missing_page_count": {"type": "integer", "minimum": 0}, "unexpected_page_count": {"type": "integer", "minimum": 0}, "pages_total": {"type": "integer", "minimum": 0}, "claims_total": {"type": "integer", "minimum": 0}, "eligible_external_units_before": {"type": "integer", "minimum": 0}, "canonical_external_units_after": {"type": "integer", "minimum": 0}, "local_units": {"type": "integer", "minimum": 0}, "target_units": {"type": "integer", "minimum": 0}, "teaching_units": {"type": "integer", "minimum": 0}, "blocked_units": {"type": "integer", "minimum": 0}, "identity_blocked_units": {"type": "integer", "minimum": 0}}},
    "routes": {"type": "object", "additionalProperties": false, "required": ["LOCAL-VERIFY", "EXTERNAL-RESEARCH", "TARGET-EVIDENCE", "TEACHING-VALIDATION", "BLOCKED-UNCLASSIFIED"], "properties": {"LOCAL-VERIFY": {"type": "integer", "minimum": 0}, "EXTERNAL-RESEARCH": {"type": "integer", "minimum": 0}, "TARGET-EVIDENCE": {"type": "integer", "minimum": 0}, "TEACHING-VALIDATION": {"type": "integer", "minimum": 0}, "BLOCKED-UNCLASSIFIED": {"type": "integer", "minimum": 0}}},
    "reuse": {"type": "object", "additionalProperties": false, "required": ["DIRECT-REUSE", "SOURCE-REUSE-DELTA", "NO-REUSE"], "properties": {"DIRECT-REUSE": {"type": "integer", "minimum": 0}, "SOURCE-REUSE-DELTA": {"type": "integer", "minimum": 0}, "NO-REUSE": {"type": "integer", "minimum": 0}, "undecided_candidate_count": {"type": "integer", "minimum": 0}, "no_reuse_candidate_count": {"type": "integer", "minimum": 0}, "audited_decision_count": {"type": "integer", "minimum": 0}}},
    "invalidation": {"type": "object", "additionalProperties": false, "required": ["current", "superseded", "invalid", "invalidation_count"], "properties": {"current": {"type": "integer", "minimum": 0}, "superseded": {"type": "integer", "minimum": 0}, "invalid": {"type": "integer", "minimum": 0}, "invalidation_count": {"type": "integer", "minimum": 0}}},
    "unclassified_count": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pageCoverage": {
      "type": "object", "additionalProperties": false,
      "required": ["coverage_source", "catalog_manifest_digest", "page_set_digest", "expected_page_ids", "covered_page_ids", "missing_page_ids", "unexpected_page_ids"],
      "properties": {
        "coverage_source": {"enum": ["catalog-manifest", "inventory-derived"]},
        "catalog_manifest_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "page_set_digest": {"$ref": "#/$defs/digest"},
        "expected_page_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "covered_page_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "missing_page_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unexpected_page_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [{"if": {"properties": {"status": {"const": "READY"}}}, "then": {"properties": {"unclassified_count": {"const": 0}, "routes": {"properties": {"BLOCKED-UNCLASSIFIED": {"const": 0}}}, "counts": {"properties": {"missing_page_count": {"const": 0}, "unexpected_page_count": {"const": 0}}}, "page_coverage": {"properties": {"coverage_source": {"const": "catalog-manifest"}, "missing_page_ids": {"maxItems": 0}, "unexpected_page_ids": {"maxItems": 0}}}}}}]
}

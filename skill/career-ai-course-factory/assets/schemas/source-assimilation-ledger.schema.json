{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceAssimilationLedger",
  "type": "object",
  "required": ["schema_version", "inventory_version", "sources", "sections", "atoms", "coverage_receipt"],
  "properties": {
    "schema_version": {"type": "string"},
    "inventory_version": {"type": "string"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "path", "sha256", "authority", "scope", "owner", "format"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "authority": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "format": {"enum": ["markdown", "text", "json", "csv", "other"]}
        }
      }
    },
    "sections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverageItem"}},
    "atoms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverageItem"}},
    "coverage_receipt": {
      "type": "object",
      "required": ["source_count", "section_count", "atom_count", "accounted_section_count", "accounted_atom_count", "disposition_counts", "unaccounted_ids", "inventory_command", "reviewer", "reviewed_at", "verdict"],
      "properties": {
        "source_count": {"type": "integer", "minimum": 1},
        "section_count": {"type": "integer", "minimum": 1},
        "atom_count": {"type": "integer", "minimum": 1},
        "accounted_section_count": {"type": "integer", "minimum": 0},
        "accounted_atom_count": {"type": "integer", "minimum": 0},
        "disposition_counts": {"type": "object"},
        "unaccounted_ids": {"type": "array", "maxItems": 0},
        "inventory_command": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "minLength": 1},
        "verdict": {"const": "PASS"}
      }
    }
  },
  "$defs": {
    "coverageItem": {
      "type": "object",
      "required": ["id", "source_id", "locator", "start_line", "end_line", "sha256", "meaning", "disposition", "target_refs", "rationale", "owner", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "meaning": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["incorporated", "adapted", "rejected", "blocked", "superseded"]},
        "target_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

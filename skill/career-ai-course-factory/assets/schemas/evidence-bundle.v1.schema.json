{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-bundle.v1.schema.json",
  "title": "EvidenceBundleV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "bundle_id", "bundle_revision", "bundle_digest", "anchor_claim_id", "member_claim_ids", "evidence_class", "route", "digests", "origin_receipts", "source_locators", "predicate_ids", "supports_predicates", "cannot_prove", "invalidation", "provider_receipt_status"],
  "properties": {
    "schema_version": {"const": "evidence-bundle.v1"},
    "artifact_kind": {"const": "evidence-bundle"},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_revision": {"type": "integer", "minimum": 1}, "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "anchor_claim_id": {"type": "string", "minLength": 1},
    "member_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_class": {"enum": ["STABLE-DEFINITION", "SHARED-MECHANISM", "VENDOR-VERSION", "NUMERIC-STATISTICAL", "SECURITY-AUTHORITY", "FAILURE-OPERATIONS"]},
    "route": {"const": "EXTERNAL-RESEARCH"},
    "digests": {"$ref": "#/$defs/digestSet"},
    "origin_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/originReceipt"}},
    "source_locators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}}, "predicate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "supports_predicates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "cannot_prove": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invalidation": {"$ref": "#/$defs/invalidation"},
    "provider_receipt_status": {"const": "referenced-only-not-a-receipt"},
    "receipt_status": {"enum": ["bundle-ready", "bundle-superseded", "bundle-invalid"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestSet": {"type": "object", "additionalProperties": false, "required": ["scope_digest", "version_digest", "environment_digest", "region_digest", "risk_digest"], "properties": {"scope_digest": {"$ref": "#/$defs/digest"}, "version_digest": {"$ref": "#/$defs/digest"}, "environment_digest": {"$ref": "#/$defs/digest"}, "region_digest": {"$ref": "#/$defs/digest"}, "risk_digest": {"$ref": "#/$defs/digest"}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["locator_id", "kind", "uri_or_path", "digest"], "properties": {"locator_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["external", "target", "local", "fixture"]}, "uri_or_path": {"type": "string", "minLength": 1}, "fragment": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
    "originReceipt": {"type": "object", "additionalProperties": false, "required": ["receipt_id", "receipt_schema_version", "receipt_path", "receipt_digest", "provider", "surface", "status"], "properties": {"receipt_id": {"type": "string", "minLength": 1}, "receipt_schema_version": {"enum": ["deep-research-receipts.v1", "codex-research-receipts.v1"]}, "receipt_path": {"type": "string", "minLength": 1}, "receipt_digest": {"$ref": "#/$defs/digest"}, "provider": {"enum": ["openai", "codex"]}, "surface": {"type": "string", "minLength": 1}, "status": {"const": "completed"}}},
    "invalidation": {"type": "object", "additionalProperties": false, "required": ["status", "triggers", "invalidates_node_ids"], "properties": {"status": {"enum": ["current", "superseded", "invalid"]}, "triggers": {"type": "array", "minItems": 1, "items": {"enum": ["statement-change", "scope-change", "version-change", "environment-change", "region-change", "risk-change", "source-retraction", "counterevidence-change", "contract-change", "artifact-change", "target-state-change"]}}, "invalidates_node_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"status": {"enum": ["superseded", "invalid"]}}}, "then": {"properties": {"invalidates_node_ids": {"minItems": 1}}}}]}
  }
}

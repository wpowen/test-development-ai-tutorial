{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PageProjectionLedger",
  "type": "object",
  "required": ["schema_version", "topic_id", "manuscript_sha256", "page_content_sha256", "claims", "counts", "author_id", "reviewer", "verdict"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "topic_id": {"type": "string", "minLength": 1},
    "manuscript_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "page_content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "author_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "verdict": {"const": "PASS"},
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "manuscript_locator", "meaning", "kind", "disposition", "page_target", "rationale", "owner"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "manuscript_locator": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "kind": {"enum": ["decision-rule", "judgement-table", "counterexample", "failure-mode", "metric-definition", "threshold", "boundary", "artifact"]},
          "disposition": {"enum": ["projected", "condensed", "deferred", "rejected"]},
          "page_target": {"type": "string"},
          "rationale": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["total", "projected", "condensed", "deferred", "rejected", "unaccounted"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "projected": {"type": "integer", "minimum": 0},
        "condensed": {"type": "integer", "minimum": 0},
        "deferred": {"type": "integer", "minimum": 0},
        "rejected": {"type": "integer", "minimum": 0},
        "unaccounted": {"const": 0}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfessionalEvidence",
  "type": "object",
  "required": ["schema_version", "pages"],
  "$defs": {
    "lane": {
      "type": "object",
      "required": ["status", "receipt_refs", "limitations"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED"]},
        "receipt_refs": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_id", "maturity_claim", "model", "integration", "clean_room", "practitioner", "learner"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "maturity_claim": {"enum": ["desk-researched", "fixture-tested", "model-integrated", "integration-tested", "practitioner-reviewed", "production-validated"]},
          "model": {"$ref": "#/$defs/lane"},
          "integration": {"$ref": "#/$defs/lane"},
          "clean_room": {"$ref": "#/$defs/lane"},
          "practitioner": {"$ref": "#/$defs/lane"},
          "learner": {"$ref": "#/$defs/lane"}
        }
      }
    }
  }
}

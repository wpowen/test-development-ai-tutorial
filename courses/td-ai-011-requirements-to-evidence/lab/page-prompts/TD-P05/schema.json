{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "test-package.v1.1",
  "type": "object",
  "required": [
    "page_id",
    "status",
    "oracles",
    "test_conditions",
    "test_cases",
    "blocked_tests",
    "unknowns"
  ],
  "properties": {
    "page_id": {
      "const": "TD-P05"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "PASS",
        "PARTIAL",
        "BLOCKED",
        "UNKNOWN",
        "RELEASE_CANDIDATE",
        "NOT_RUN",
        "PASS_SCHEMA",
        "PASS_SEMANTIC",
        "FAIL",
        "SCHEMA_INVALID",
        "REFUSED",
        "INCOMPLETE",
        "SOURCE_CONFLICT",
        "UNSUPPORTED_RULE",
        "SEMANTIC_UNKNOWN"
      ]
    },
    "oracles": {
      "type": "array",
      "description": "Professional output records for oracles",
      "items": {
        "type": "object"
      }
    },
    "test_conditions": {
      "type": "array",
      "description": "Professional output records for test_conditions",
      "items": {
        "type": "object"
      }
    },
    "test_cases": {
      "type": "array",
      "description": "Professional output records for test_cases",
      "items": {
        "type": "object"
      }
    },
    "blocked_tests": {
      "type": "array",
      "description": "Professional output records for blocked_tests",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "description": "Professional output records for unknowns",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://career-ai-course-factory.local/schemas/requirement-contract.schema.json",
  "title": "Requirement Contract",
  "type": "object",
  "required": ["requirement_id", "status", "statement", "actors", "preconditions", "trigger", "state_transitions", "invariants", "exceptions", "side_effects", "nfrs", "unknowns", "source_refs"],
  "additionalProperties": false,
  "properties": {
    "requirement_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
    "status": {"enum": ["ACCEPTED", "UNKNOWN", "BLOCKED"]},
    "statement": {"type": "string", "minLength": 10},
    "actors": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "trigger": {"type": "string", "minLength": 1},
    "state_transitions": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_]+->[A-Z_]+$"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "exceptions": {"type": "array", "items": {"type": "string"}},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "nfrs": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+#"}},
    "semantic_review": {
      "type": "object",
      "required": ["verdict", "reviewer", "reviewed_at"],
      "properties": {
        "verdict": {"enum": ["PASS_SEMANTIC", "FAIL_SEMANTIC", "NOT_RUN"]},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}
